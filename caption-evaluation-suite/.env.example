# Environment variables — copy to .env and fill in as needed
# All variables are optional unless noted otherwise.
# Every model ID below is one that was actually used to produce the delivered baselines.

# === API keys for caption generation & LLM judging ===
# OpenAI-compatible endpoint — used by captioners and by both LLM judges
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic native API (only used if ANTHROPIC_API_KEY is set AND no proxy override)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Volcano Ark (Doubao / Seed models)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# === Judges (must match the baselines you want to reproduce) ===
# CapsBench judge        = deepseek-v3.2   (run_capsbench.py --judge-model)
# PerceptionRubrics judge = gpt-oss-120b    (run_perceptionrubrics.py --judge-model,
#                                            passed to the official judge via JUDGE_MODEL)
JUDGE_MODEL=gpt-oss-120b

# === Local model checkpoints ===
# CompreCap official evaluator
COMPRECAP_LLM_PATH=/path/to/Llama-3.1-8B-Instruct
COMPRECAP_BERT_PATH=/path/to/all-MiniLM-L6-v2
