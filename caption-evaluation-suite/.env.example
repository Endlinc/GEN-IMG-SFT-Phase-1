# Environment variables — copy to .env, fill in, then `set -a; . ./.env; set +a`.
# Nothing loads this file automatically.

# The proxy in use issues ONE KEY PER MODEL FAMILY, so a single OPENAI_API_KEY
# cannot cover both caption routes. Family-specific variables win when set;
# OPENAI_API_KEY is the fallback, so a single-key endpoint still works unchanged.

# === Caption generation ===
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=          # GPT route
CLAUDE_API_KEY=          # Claude route (falls back to OPENAI_API_KEY)
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Anthropic native API (only used if ANTHROPIC_API_KEY is set AND the base URL
# is api.openai.com, i.e. no proxy override)
ANTHROPIC_API_KEY=

# Volcano Ark (Doubao / Seed models)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# === CapsBench judge ===
# Text-only yes/no. Thinking models (deepseek-v4-flash) get `thinking: disabled`
# inside run_capsbench.py, which is required: otherwise the reasoning trace eats
# the token budget, content comes back empty, and every question silently scores
# "n/a" — collapsing accuracy to ~0 with no error.
#
# CapsBench's judge model comes from --judge-model (default deepseek-v4-flash);
# it does not read JUDGE_MODEL.
JUDGE_API_KEY=           # falls back to OPENAI_API_KEY

# === PerceptionRubrics judge ===
# Env-var fallback for the official judge.py; --model on its command line wins.
# Keep this equal to the baseline judge when reproducing results (README 5.4).
JUDGE_MODEL=gpt-oss-120b

# === Local model checkpoints ===
# CompreCap official evaluator (read by code/run_comprecap.py)
COMPRECAP_LLM_PATH=/path/to/Llama-3.1-8B-Instruct
COMPRECAP_BERT_PATH=/path/to/all-MiniLM-L6-v2
#
# CAPTURE's two checkpoints (all-mpnet-base-v2 sentence encoder,
# flan-t5-base-VG-factual-sg scene-graph parser) come from the Hugging Face hub
# on first use and cache normally. To pin them to a local copy, set HF_HOME —
# there is no bundle-specific variable for this.
